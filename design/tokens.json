{
  "$comment": [
    "Arena design system — SINGLE SOURCE OF TRUTH shared by every client.",
    "Web (frontend/) is the canonical visual reference; the desktop client",
    "(desktop/) and any future mobile client must consume this file, never",
    "hand-copy values. Loaded by desktop/design_tokens.py (Python) and",
    "frontend/src/design/tokens.ts (TS); enforced by tests/test_design_tokens.py",
    "and frontend/src/test/design-tokens.test.ts."
  ],
  "color": {
    "themes": {
      "dark": {
        "background": {
          "primary": "#0F172A",
          "secondary": "#1E293B",
          "surface": "#334155"
        },
        "text": {
          "primary": "#F1F5F9",
          "secondary": "#94A3B8",
          "muted": "#64748B"
        },
        "accent": "#3B82F6"
      },
      "light": {
        "background": {
          "primary": "#F8FAFC",
          "secondary": "#E2E8F0",
          "surface": "#CBD5E1"
        },
        "text": {
          "primary": "#1E293B",
          "secondary": "#475569",
          "muted": "#64748B"
        },
        "accent": "#3B82F6"
      }
    },
    "accent": {
      "primary": "#3B82F6",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444"
    },
    "knowledge_node_types": {
      "concept": "#8B5CF6",
      "entity": "#3B82F6",
      "memory": "#10B981",
      "conversation": "#F59E0B",
      "file": "#EC4899",
      "other": "#94A3B8"
    },
    "memory_types": {
      "episodic": "#8B5CF6",
      "semantic": "#3B82F6",
      "procedural": "#10B981",
      "conversation": "#F59E0B",
      "empty": "#E2E8F0"
    }
  },
  "beanie": {
    "comment": "Beanie presence state machine — the agent's shared cognitive states, rendered per platform.",
    "states": {
      "idle": {
        "label": "Idle",
        "color": "#3B82F6",
        "duration_ms": 3400
      },
      "working": {
        "label": "Working",
        "color": "#F59E0B",
        "duration_ms": 1600
      },
      "listening": {
        "label": "Listening",
        "color": "#10B981",
        "duration_ms": 1200
      },
      "speaking": {
        "label": "Speaking",
        "color": "#8B5CF6",
        "duration_ms": 1050
      },
      "offline": {
        "label": "Offline",
        "color": "#334155",
        "duration_ms": 0
      },
      "thinking": {
        "label": "Thinking",
        "color": "#F59E0B",
        "duration_ms": 1600
      },
      "acting": {
        "label": "Acting",
        "color": "#38BDF8",
        "duration_ms": 2000
      },
      "observing": {
        "label": "Observing",
        "color": "#38BDF8",
        "duration_ms": 2000
      },
      "success": {
        "label": "Success",
        "color": "#10B981",
        "duration_ms": 2000
      },
      "error": {
        "label": "Error",
        "color": "#EF4444",
        "duration_ms": 400
      },
      "sleeping": {
        "label": "Sleeping",
        "color": "#334155",
        "duration_ms": 5000
      }
    }
  },
  "typography": {
    "font_family": "Inter, system-ui, sans-serif",
    "base_font_size_px": 14
  }
}
