{
  "$comment": [
    "Arena design system — SINGLE SOURCE OF TRUTH shared by every client.",
    "Atmosphere (round-21q): light emitted by Beanie into a dark environment —",
    "near-black navy canvas, translucent deep-navy panels (background.panel +",
    "panel_alpha), subtle blue borders (border.*), electric-blue accent, and a",
    "blue→violet glow (glow.*). The presence states (beanie.states) are the light",
    "source. Web (frontend/) is the canonical visual reference; loaded by",
    "desktop/design_tokens.py and frontend/src/design/tokens.ts; enforced by",
    "tests/test_design_tokens.py and frontend/src/test/design-tokens.test.ts."
  ],
  "color": {
    "themes": {
      "dark": {
        "background": {
          "primary": "#060A16",
          "secondary": "#0B1226",
          "surface": "#151F3A",
          "panel": "#0D1730",
          "elevated": "#1C2946",
          "panel_alpha": 0.72
        },
        "text": {
          "primary": "#F1F5F9",
          "secondary": "#94A3B8",
          "muted": "#64748B"
        },
        "accent": "#3D74FF",
        "border": {
          "subtle": "#20304F",
          "active": "#3A5480"
        },
        "glow": {
          "primary": "#5B8CFF",
          "secondary": "#8B5CF6"
        }
      },
      "light": {
        "background": {
          "primary": "#F8FAFC",
          "secondary": "#E2E8F0",
          "surface": "#CBD5E1",
          "panel": "#E8EDF5",
          "elevated": "#F1F5FA",
          "panel_alpha": 0.72
        },
        "text": {
          "primary": "#1E293B",
          "secondary": "#475569",
          "muted": "#64748B"
        },
        "accent": "#3D74FF",
        "border": {
          "subtle": "#D3DCEA",
          "active": "#B7C6DE"
        },
        "glow": {
          "primary": "#5B8CFF",
          "secondary": "#8B5CF6"
        }
      }
    },
    "accent": {
      "primary": "#3D74FF",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "secondary": "#8B5CF6"
    },
    "knowledge_node_types": {
      "concept": "#8B5CF6",
      "entity": "#3B82F6",
      "memory": "#10B981",
      "conversation": "#F59E0B",
      "file": "#EC4899",
      "other": "#94A3B8"
    },
    "memory_types": {
      "episodic": "#8B5CF6",
      "semantic": "#3B82F6",
      "procedural": "#10B981",
      "conversation": "#F59E0B",
      "empty": "#E2E8F0"
    }
  },
  "beanie": {
    "comment": "Beanie presence state machine — the agent's shared cognitive states, rendered per platform.",
    "states": {
      "idle": {
        "label": "Idle",
        "color": "#3B82F6",
        "duration_ms": 3400
      },
      "working": {
        "label": "Working",
        "color": "#F59E0B",
        "duration_ms": 1600
      },
      "listening": {
        "label": "Listening",
        "color": "#10B981",
        "duration_ms": 1200
      },
      "speaking": {
        "label": "Speaking",
        "color": "#8B5CF6",
        "duration_ms": 1050
      },
      "offline": {
        "label": "Offline",
        "color": "#334155",
        "duration_ms": 0
      },
      "thinking": {
        "label": "Thinking",
        "color": "#F59E0B",
        "duration_ms": 1600
      },
      "acting": {
        "label": "Acting",
        "color": "#38BDF8",
        "duration_ms": 2000
      },
      "observing": {
        "label": "Observing",
        "color": "#38BDF8",
        "duration_ms": 2000
      },
      "success": {
        "label": "Success",
        "color": "#10B981",
        "duration_ms": 2000
      },
      "error": {
        "label": "Error",
        "color": "#EF4444",
        "duration_ms": 400
      },
      "sleeping": {
        "label": "Sleeping",
        "color": "#334155",
        "duration_ms": 5000
      }
    }
  },
  "typography": {
    "font_family": "Inter, system-ui, sans-serif",
    "base_font_size_px": 14,
    "scale_px": {
      "caption": 12,
      "body": 14,
      "subtitle": 16,
      "title": 18,
      "display": 30
    },
    "weights": {
      "regular": 400,
      "semibold": 600,
      "bold": 700
    }
  },
  "radius": {
    "comment": "Matches the Tailwind v4 default scale the web compiles to (rounded=4, rounded-lg=8, rounded-xl=12, rounded-2xl=16, rounded-full).",
    "sm_px": 4,
    "md_px": 6,
    "lg_px": 8,
    "xl_px": 12,
    "xxl_px": 16,
    "full_px": 9999
  },
  "spacing": {
    "unit_px": 4,
    "scale_px": [
      4,
      8,
      12,
      16,
      24,
      32
    ],
    "control_padding_x_px": 16,
    "control_padding_y_px": 8,
    "field_padding_x_px": 12,
    "field_padding_y_px": 8,
    "bubble_padding_x_px": 16,
    "bubble_padding_y_px": 10
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "DEFAULT": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
    "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)",
    "inner": "inset 0 2px 4px 0 rgba(0, 0, 0, 0.05)"
  },
  "motion": {
    "fast_ms": 150,
    "base_ms": 300,
    "pulse_slow_ms": 2000,
    "pulse_fast_ms": 1000,
    "easing": "cubic-bezier(0.4, 0, 0.6, 1)"
  },
  "focus": {
    "comment": "Focus ring spec; ring color is color.accent.primary (web: focus:ring-2 ring-accent-primary).",
    "ring_width_px": 2
  }
}
