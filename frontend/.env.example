# Arena Environment Variables
# Copy this file to .env and customize for your setup

# ============================================================================
# Backend Configuration
# ============================================================================

# LLM Provider URL (LM Studio, Ollama, or OpenAI-compatible API)
# LM Studio default: http://localhost:1234/v1
# Ollama default:    http://localhost:11434/v1
LPA_LM_STUDIO_URL=http://localhost:1234/v1

# Model names
LPA_FAST_MODEL=qwen2.5-3b-instruct
LPA_MAIN_MODEL=qwen2.5-9b-instruct

# Request timeout (seconds) - extended for model loading
LPA_DEFAULT_TIMEOUT=180.0

# ============================================================================
# Security (Optional)
# ============================================================================

# API Key for authentication (leave empty to disable auth)
# ARENA_API_KEY=your-secret-key-here

# CORS allowed origins (comma-separated)
# ARENA_CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# ============================================================================
# Frontend Configuration
# ============================================================================

# Backend API URL (used by frontend to connect to backend)
# VITE_API_URL=http://localhost:8000

# WebSocket URL (used by frontend for real-time communication)
# VITE_WS_URL=ws://localhost:8000/ws

# API Key (must match ARENA_API_KEY if auth is enabled)
# VITE_API_KEY=your-secret-key-here
