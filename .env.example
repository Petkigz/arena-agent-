# Local Personal Assistant example configuration
# Copy to .env and adjust values for your LM Studio setup.

LPA_APP_NAME="Local Personal Assistant"
LPA_DEBUG=true
LPA_LM_STUDIO_URL="http://localhost:1234/v1"
LPA_FAST_MODEL="qwen2.5-3b-instruct"
LPA_MAIN_MODEL="qwen2.5-9b-instruct"
LPA_DEFAULT_TIMEOUT=180
